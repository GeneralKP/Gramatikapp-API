[Unit]
Description=Gramatik production API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=gramatik-api
Group=gramatik-api
WorkingDirectory=/opt/gramatik-api/current
EnvironmentFile=/etc/gramatik-api/api.env
ExecStart=/usr/bin/node --max-old-space-size=384 dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/etc/hope-and-heart -/opt/hope-and-heart -/etc/cloudflared -/etc/caddy -/run/gramatik-proxy -/var/lib/gramatik-proxy
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=512M
MemoryMax=768M
CPUQuota=100%
TasksMax=128
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gramatik-api

[Install]
WantedBy=multi-user.target
