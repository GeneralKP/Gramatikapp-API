{
    admin unix//run/gramatik-proxy/admin.sock
    auto_https disable_redirects
    servers {
        protocols h1 h2
    }
}

# A dedicated listener keeps Hope & Heart's port 443 and Caddy service separate.
# HTTP port 80 is used only for ACME validation and automatic certificate renewal.
https://vps-0f140ad8.vps.ovh.net:8443 {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    encode gzip
    header X-Content-Type-Options nosniff
    reverse_proxy 127.0.0.1:4000
}
