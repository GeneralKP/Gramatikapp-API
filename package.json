{
  "name": "german-gramatic-api",
  "version": "1.0.0",
  "description": "GraphQL backend for German Gramatic learning app",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run copy-graphql",
    "copy-graphql": "copyfiles -u 1 \"src/**/*.graphql\" dist",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test:contexts": "node scripts/testLearningContexts.mjs",
    "test:word-translations": "tsx scripts/testWordTranslations.ts",
    "audit:phrase-translations": "tsx scripts/seedPhraseTranslations.ts audit",
    "seed:phrase-translations": "tsx scripts/seedPhraseTranslations.ts apply",
    "seed": "tsx scripts/seedFromJson.ts",
    "test:anki": "tsx scripts/testAnki.ts",
    "test:failures": "tsx scripts/testFailures.ts",
    "import:anki": "tsx scripts/importAnki.ts",
    "test:scheduler": "tsx scripts/testScheduler.ts",
    "test:reviews": "tsx scripts/testReviews.ts",
    "test:new-words": "tsx scripts/testNewWords.ts",
    "test:new-words-browser": "tsx scripts/testNewWordsBrowser.ts",
    "pair:native-words": "tsx scripts/pairNativeWords.ts",
    "test:browser-server": "tsx scripts/testBrowserServer.ts",
    "test:reading": "tsx scripts/testReading.ts",
    "test:reading-browser": "tsx scripts/testReadingBrowser.ts",
    "test:reading-live": "tsx scripts/testReadingLive.ts",
    "test:reading-validation": "tsx scripts/testReadingValidation.ts",
    "migrate:scheduler": "tsx scripts/migrateAnkiScheduler.ts",
    "test:writing": "tsx scripts/testWriting.ts",
    "test:writing-validation": "tsx scripts/testWritingValidation.ts",
    "test:writing-vocabulary": "tsx scripts/testWritingVocabulary.ts",
    "test:writing-live": "tsx scripts/testWriting.ts --live",
    "classify:levels": "tsx scripts/classifyLevels.ts",
    "sync:levels": "tsx scripts/syncVocabularyLevels.ts",
    "test:writing-browser": "tsx scripts/testWritingBrowser.ts",
    "test:levels": "tsx scripts/testLevels.ts",
    "test:study-controls": "tsx scripts/testStudyControls.ts",
    "audit:categories": "tsx scripts/auditStudyCategories.ts",
    "test:study-scheduling": "tsx scripts/testStudyScheduling.ts",
    "test:study-sync": "tsx scripts/testStudySync.ts",
    "test:study-sync-browser": "tsx scripts/testStudySyncBrowser.ts",
    "test:study-sync-validation": "tsx scripts/testStudySyncValidation.ts",
    "generate:browser-scheduler": "node scripts/generateBrowserScheduler.mjs"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@graphql-tools/graphql-file-loader": "^8.1.9",
    "@graphql-tools/load": "^8.1.8",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.1.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "graphql": "^16.9.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2"
  }
}
